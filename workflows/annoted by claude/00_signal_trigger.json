      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8f69db34-646c-58ea-8bf5-b47b06c96797",
              "leftValue": "={{ $json.pilot_mode }}",
              "rightValue": "live",
              "operator": {
