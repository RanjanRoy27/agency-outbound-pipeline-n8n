    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO agency_outbound.signal_events (source, company_name, company_domain, signal_type, signal_detail, detected_at, status)\nSELECT '={{ $json.source }}', '={{ $json.company_name }}', '={{ $json.company_domain }}', '={{ $json.signal_type }}', '={{ JSON.stringify($json.signal_detail).replace(/'/g, \"''\") }}'::jsonb, COALESCE('={{ $json.detected_at }}'::timestamptz, NOW()), 'new'\nWHERE NOT EXISTS (\n  SELECT 1 FROM agency_outbound.signal_events WHERE company_domain = '={{ $json.company_domain }}' AND signal_type = '={{ $json.signal_type }}'\n);",
        "options": {
          "queryBatching": "independently"
        }
      },
