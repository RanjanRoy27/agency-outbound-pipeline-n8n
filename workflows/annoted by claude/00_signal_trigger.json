    },
    {
      "parameters": {
        "jsCode": "const row = $json;\nconst html = row.body || row.data || row.html || '';\nconst text = typeof html === 'string' ? html : JSON.stringify(html);\nconst tech = [];\nif (/gtag|googletagmanager|google-analytics/i.test(text)) tech.push('google_analytics');\nif (/segment\\.com|analytics\\.js/i.test(text)) tech.push('segment');\nif (/hotjar/i.test(text)) tech.push('hotjar');\nif (/intercom/i.test(text)) tech.push('intercom');\nif (tech.length === 0) tech.push('unknown_or_missing_tracking');\nreturn [{json: {...row, source: 'tech_stack', signal_type: tech.includes('unknown_or_missing_tracking') ? 'missing_tracking_script' : 'tracking_stack_detected', signal_detail: {...(row.signal_detail || {}), detected_technologies: tech}, detected_at: new Date().toISOString()}}];"
      },
      "id": "af4fab4a-c1e3-508b-817e-d3bfdb530322",
      "name": "Detect Tech Stack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
