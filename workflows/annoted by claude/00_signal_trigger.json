    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.apify.com/v2/acts/' + ($env.APIFY_ACTOR_ID || 'REPLACE_ACTOR_ID') + '/run-sync-get-dataset-items?clean=true&format=json' }}",
        "options": {
          "timeout": 90000
        },
        "responseFormat": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.APIFY_API_TOKEN || 'REPLACE_IN_N8N_ENV') }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({keywords: ['customer support representative', 'support operations'], maxItems: 25}) }}"
      },
      "id": "d310f08f-86f8-5212-8da0-c871c1c0fc17",
      "name": "Run Apify Job-board Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        -120
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nreturn [\n  {json: {source: 'job_post', company_name: 'Northstar Support', company_domain: 'northstarsupport.example', signal_type: 'hiring_support_reps', signal_detail: {title: 'Customer Support Representative', source: 'fixture'}, detected_at: now}},\n  {json: {source: 'tech_stack', company_name: 'Orbit Commerce', company_domain: 'orbitcommerce.example', signal_type: 'missing_tracking_script', signal_detail: {technology: 'analytics-missing', source: 'fixture'}, detected_at: now}},\n  {json: {source: 'job_post', company_name: 'Harbor SaaS', company_domain: 'harborsaas.example', signal_type: 'hiring_support_reps', signal_detail: {title: 'Support Operations Manager', source: 'fixture'}, detected_at: now}},\n];"
      },
      "id": "6d3ec141-d399-5807-b476-667f83ba4e01",
      "name": "Load Fixture Signal Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json;\nconst rows = Array.isArray(raw) ? raw : (raw.items || raw.data || [raw]);\nconst out = [];\nfor (const row of rows) {\n  const company = row.company_name || row.company || row.organization || row.companyName;\n  const domain = row.company_domain || row.domain || row.companyDomain;\n  const title = row.title || row.job_title || row.position || '';\n  if (!company || !domain) continue;\n  if (title && !/(support|customer success|service operations)/i.test(title) && !row.signal_type) continue;\n  out.push({json: {source: row.source || 'job_post', company_name: company, company_domain: domain.replace(/^https?:\\/\\//, '').replace(/\\/$/, ''), signal_type: row.signal_type || 'hiring_support_reps', signal_detail: row.signal_detail || row, detected_at: row.detected_at || new Date().toISOString()}});\n}\nreturn out;"
      },
      "id": "bb71341f-9f36-5910-bdb5-0ccdc53f832e",
      "name": "Normalize Job Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://' + $json.company_domain }}",
        "options": {
          "timeout": 20000
        },
        "responseFormat": "text"
      },
      "id": "e28c8660-4765-5ed6-9a2e-16146795d0be",
      "name": "Fetch Target Homepage",
