    {
      "parameters": {
        "mode": "combine",
        "combineBy": "position",
        "options": {}
      },
      "id": "2484d6be-a8f2-5beb-bfb7-5bdbebea84f5",
      "name": "Merge Homepage Context",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1320,
        0
