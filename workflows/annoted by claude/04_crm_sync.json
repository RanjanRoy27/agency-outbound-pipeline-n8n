            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents: [{parts: [{text: 'Classify the reply into exactly one label: interested, not_interested, ooo, objection. Return JSON with keys classification and rationale. Reply text: ' + $json.raw_reply_text}]}], generationConfig: {temperature: 0, responseMimeType: 'application/json', maxOutputTokens: 120}}) }}",
        "authentication": "genericCredentialType",
