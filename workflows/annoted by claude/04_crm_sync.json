        "query": "WITH inserted AS (\n  INSERT INTO agency_outbound.replies_inbox (send_queue_id, raw_reply_text, classification, crm_synced)\n  VALUES (NULLIF('={{ $json.send_queue_id || '' }}','')::bigint, '={{ $json.raw_reply_text.replace(/'/g, \"''\") }}', NULL, FALSE)\n  RETURNING id\n)\nSELECT id AS reply_id, '={{ $json.raw_reply_text.replace(/'/g, \"''\") }}' AS raw_reply_text, '={{ $json.lead_name || '' }}' AS lead_name, '={{ $json.lead_email || '' }}' AS lead_email FROM inserted;",
