        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const t = String($json.raw_reply_text || '').toLowerCase(); const classification = /interested|book|call|yes|curious/.test(t) ? 'interested' : /out of office|ooo|vacation/.test(t) ? 'ooo' : /not interested|unsubscribe|remove/.test(t) ? 'not_interested' : 'objection'; return [{json: {...$json, classification}}];"
      },
      "id": "3abcd2dc-3d02-5a7d-8f25-2daeb5a07d28",
      "name": "Fixture Reply Classifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nlet classification = r.classification;\ntry { const text = r.candidates?.[0]?.content?.parts?.[0]?.text; if (text) classification = JSON.parse(text).classification; } catch (e) {}\nconst allowed = ['interested', 'not_interested', 'ooo', 'objection'];\nreturn [{json: {...r, classification: allowed.includes(classification) ? classification : 'objection'}}];"
      },
      "id": "3136d622-373b-504d-96ae-a8ebb2f82f28",
      "name": "Normalize Reply Classification",
