    {
      "parameters": {
        "jsCode": "return [{json: {person: {first_name: 'Alex', last_name: 'Morgan', email: 'alex.morgan@' + ($json.company_domain || 'example.com'), title: 'Head of Support', linkedin_url: 'https://www.linkedin.com/in/alex-morgan'}, credits_consumed: 1}}];"
      },
