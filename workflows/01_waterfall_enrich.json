    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO agency_outbound.integration_usage (workflow_name, provider, operation, rows_processed, provider_units, estimated_cost_usd, metadata) VALUES ('01_waterfall_enrich', '={{ $json.email_source || 'unresolved' }}', 'email_resolution', 1, '={{ Number($json.resolution_cost || 0) }}', 0, jsonb_build_object('mx_verified', '={{ Boolean($json.mx_verified) }}'));",
        "options": {
          "queryBatching": "independently"
        }
      },
