      "id": "528999ca-39c9-5f3b-8a81-ef4e70f9c85e",
      "name": "Set Resolution Tier",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2390,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n  INSERT INTO agency_outbound.prospects_enriched (signal_event_id, full_name, email, email_source, resolution_tier, resolution_cost, title, linkedin_url, mx_verified, status)\n  VALUES ('={{ $json.id }}', '={{ ($json.full_name || '').replace(/'/g, \"''\") }}', NULLIF('={{ $json.email || '' }}',''), '={{ $json.email_source }}', '={{ Number($json.resolution_tier || 0) }}', '={{ Number($json.resolution_cost || 0) }}', NULLIF('={{ ($json.title || '').replace(/'/g, \"''\") }}',''), NULLIF('={{ $json.linkedin_url || '' }}',''), '={{ Boolean($json.mx_verified) }}', 'new')\n  RETURNING id\n)\nSELECT id AS prospect_id, '={{ $json.id }}'::bigint AS signal_event_id, '={{ $json.email_source }}' AS email_source, '={{ Number($json.resolution_cost || 0) }}'::numeric AS resolution_cost, '={{ Boolean($json.mx_verified) }}'::boolean AS mx_verified FROM inserted;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "bcd7ca86-1f77-5dcb-a526-3c55f62e5327",
      "name": "Insert Enriched Prospect",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2610,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Agency Outbound Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n  UPDATE agency_outbound.signal_events SET status = 'enriched' WHERE id = '={{ $json.signal_event_id }}' RETURNING id\n)\nSELECT id AS signal_event_id, '={{ $json.prospect_id }}'::bigint AS prospect_id, '={{ $json.email_source }}' AS email_source, '={{ Number($json.resolution_cost || 0) }}'::numeric AS resolution_cost, '={{ Boolean($json.mx_verified) }}'::boolean AS mx_verified FROM updated;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "2a3aaf71-6035-5314-9837-bca4b40fb163",
      "name": "Mark Signal Enriched",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2830,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
