    {
      "parameters": {
        "mode": "append"
      },
      "id": "230c2201-0d64-5fa0-bbe9-2ce769abc44d",
      "name": "Merge Apollo and Hunter Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1730,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const row = $json;\nconst person = row.person || {};\nconst hunter = row.data || row;\nconst email = person.email || person.email_address || (hunter.emails && hunter.emails[0] && hunter.emails[0].value) || null;\nconst fullName = [person.first_name || (hunter.emails && hunter.emails[0] && hunter.emails[0].first_name), person.last_name || (hunter.emails && hunter.emails[0] && hunter.emails[0].last_name)].filter(Boolean).join(' ') || 'Unresolved contact';\nconst source = person.email ? 'apollo' : email ? 'hunter' : 'unresolved';\nconst tier = person.email ? 1 : email ? 2 : 0;\nreturn [{json: {...row, full_name: fullName, email, email_source: source, resolution_tier: tier, resolution_cost: Number(row.credits_consumed || (tier === 2 ? 1 : 0)), title: person.title || (hunter.emails && hunter.emails[0] && hunter.emails[0].position) || null, linkedin_url: person.linkedin_url || (hunter.emails && hunter.emails[0] && hunter.emails[0].linkedin) || null}}];"
      },
      "id": "f85e029a-4797-5cf0-82c0-a212870ea72c",
      "name": "Select Best Enriched Prospect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1950,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const dns = require('dns').promises;\nconst domain = String($json.company_domain || '').trim();\nlet mx_verified = false;\ntry { mx_verified = (await dns.resolveMx(domain)).length > 0; } catch (e) { mx_verified = false; }\nreturn [{json: {...$json, mx_verified}}];"
      },
      "id": "7b471ec0-dc0d-56d2-afab-91beba40416f",
      "name": "Check MX Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2170,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "8e1354ae-4b60-5506-a4b6-7d23f72f09f8",
              "name": "email_source",
              "type": "string",
              "value": "={{ $json.email_source || 'unresolved' }}"
            },
            {
              "id": "730c003e-2136-584f-84ac-ff45e7c09a68",
              "name": "resolution_cost",
              "type": "number",
              "value": "={{ Number($json.resolution_cost || 0) }}"
