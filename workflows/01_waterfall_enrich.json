        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({domain: $json.company_domain, reveal_personal_emails: true, first_name: $json.full_name ? $json.full_name.split(' ')[0] : undefined}) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
