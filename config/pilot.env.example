# Copy values into the n8n instance environment or equivalent secret manager.
# Do not commit real values. The workflow JSON deliberately contains only references.

# Execution mode: fixture = deterministic demo, live = external providers
PILOT_MODE=fixture
DRY_RUN=true

# Provider configuration
APIFY_ACTOR_ID=REPLACE_WITH_APPROVED_ACTOR_ID
APIFY_API_TOKEN=REPLACE_IN_N8N_SECRET
APOLLO_API_KEY=REPLACE_IN_N8N_SECRET
HUNTER_API_KEY=REPLACE_IN_N8N_SECRET
GEMINI_API_KEY=REPLACE_IN_N8N_SECRET
GEMINI_MODEL=gemini-3.5-flash-lite
SLACK_WEBHOOK_URL=REPLACE_IN_N8N_SECRET

# Optional one-mailbox demo only. Keep unset unless the sandbox mailbox is approved.
SANDBOX_MAILBOX_TO=REPLACE_WITH_OPERATOR_APPROVED_ADDRESS

# n8n deployment API values are not used by imported workflows.
# If the instance supports the public API, store these outside the repo.
N8N_BASE_URL=https://your-n8n.example
N8N_API_KEY=REPLACE_IN_SECRET_MANAGER
N8N_API_AUTH_HEADER=X-N8N-API-KEY

# Database connection is configured as an n8n Postgres credential, not as workflow JSON.
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DATABASE=your-database
POSTGRES_USER=your-user
POSTGRES_PASSWORD=REPLACE_IN_SECRET_MANAGER
